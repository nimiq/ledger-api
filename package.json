{
  "name": "@nimiq/ledger-api",
  "version": "4.0.1",
  "description": "Api for communicating with Ledger Hardware Wallets",
  "type": "module",
  "main": "dist/high-level-api/ledger-api.es.js",
  "types": "dist/high-level-api/ledger-api.d.ts",
  "exports": {
    ".": {
      "types": "./dist/high-level-api/ledger-api.d.ts",
      "default": "./dist/high-level-api/ledger-api.es.js"
    },
    "./low-level-api": {
      "types": "./dist/low-level-api/low-level-api.d.ts",
      "default": "./dist/low-level-api/low-level-api.es.js"
    },
    "./dist/*": "./dist/*",
    "./package.json": "./package.json"
  },
  "files": [
    "transport-comparison.md",
    "dist",
    "!dist/demo"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json",
    "dev": "vite --config vite.demo.config.ts",
    "serve": "yarn dev",
    "build:demo": "vite build --config vite.demo.config.ts",
    "typecheck": "tsc && tsc -p tsconfig.node.json",
    "lint": "eslint .",
    "prepublishOnly": "yarn typecheck && yarn lint && yarn build",
    "speculos-bridge": "node speculos-bridge/speculos-bridge.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nimiq/ledger-api.git"
  },
  "keywords": [
    "nimiq",
    "ledger",
    "hardware-wallet",
    "api"
  ],
  "author": "Nimiq (https://www.nimiq.com)",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/nimiq/ledger-api/issues"
  },
  "homepage": "https://github.com/nimiq/ledger-api#readme",
  "engines": {
    "node": ">=20.19"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@ledgerhq/hw-transport-node-speculos": "^6.34.7",
    "@ledgerhq/logs": "^6.20.0",
    "@stylistic/eslint-plugin": "^6.0.1",
    "@types/node": "^26.6.6",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "bitcoinjs-message": "^2.2.0",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "magic-string": "^1.4.5",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vite-plugin-node-polyfills": "^0.28.0",
    "ws": "^8.23.0"
  },
  "dependencies": {
    "@ledgerhq/hw-app-btc": "^12.3.0",
    "@ledgerhq/hw-transport": "^6.37.0",
    "@ledgerhq/hw-transport-http": "^6.36.5",
    "@ledgerhq/hw-transport-web-ble": "^6.35.0",
    "@ledgerhq/hw-transport-webhid": "^6.36.0",
    "@ledgerhq/hw-transport-webusb": "^6.35.0",
    "@nimiq/core": "^2.23.0",
    "@scure/bip32": "^2.4.0",
    "@types/w3c-web-usb": "^1.0.14",
    "bitcoinjs-lib": "^7.0.5"
  }
}
